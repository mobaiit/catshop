{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catshop",
  "workers_dev": true,
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catshop_db",
      "database_id": "da3103d0-b2ff-43ae-8ac6-04dd2c54b511",
      "migrations_dir": "database/migrations",
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
     "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
}
