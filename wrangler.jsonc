{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "catshop",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "catshop.us.ci",
      "custom_domain": true
    }
  ],
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "catshop_db",
      "database_id": "f0268736-9705-40cd-a8aa-9e451a0345a0",
      "migrations_dir": "database/migrations",
    }
  ],
  "compatibility_flags": [
    "nodejs_compat",
     "global_fetch_strictly_public"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
		"enabled": true,
		"head_sampling_rate": 0.1
	},
}
